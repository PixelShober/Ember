<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Ember</AssemblyName>
    <RootNamespace>Ember.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ember.ico</ApplicationIcon>

    <!-- Release: one self-contained Ember.exe that runs on any Windows 10/11 x64 without installing .NET. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>

    <!-- The built web UI that gets embedded (ui/dist after "npm run build"). -->
    <EmberUiDist>$(MSBuildThisFileDirectory)..\..\ui\dist</EmberUiDist>
    <EmberUiZip>$(BaseIntermediateOutputPath)ember-ui.zip</EmberUiZip>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only runtime dependency besides .NET: the WPF control for the (preinstalled) WebView2 runtime. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <ProjectReference Include="..\Ember.Core\Ember.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ember.ico" />
  </ItemGroup>

  <Target Name="EmbedUi" BeforeTargets="BeforeBuild">
    <Warning Condition="!Exists('$(EmberUiDist)\index.html')"
             Text="ui/dist fehlt – Ember bettet nur eine Platzhalter-Seite ein. Vorher in ui/ 'npm ci' und 'npm run build' ausführen." />
    <MakeDir Directories="$(BaseIntermediateOutputPath)" Condition="Exists('$(EmberUiDist)\index.html')" />
    <ZipDirectory Condition="Exists('$(EmberUiDist)\index.html')"
                  SourceDirectory="$(EmberUiDist)" DestinationFile="$(EmberUiZip)" Overwrite="true" />
    <ItemGroup Condition="Exists('$(EmberUiDist)\index.html')">
      <EmbeddedResource Include="$(EmberUiZip)" LogicalName="Ember.ui.zip" />
    </ItemGroup>
  </Target>

</Project>
