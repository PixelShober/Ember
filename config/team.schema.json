{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelshober.github.io/Ember/team.schema.json",
  "title": "Ember-Team-Konfiguration",
  "description": "Teamdatei für Ember. Pflicht sind serviceCenter, supervisor, access, update, playwright und mailTemplates, alles andere ist optional. Im Betrieb liegt sie signiert als team.ember vor und wird nur im Tab Berechtigungen bearbeitet.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "text": {
      "description": "Text in einer Sprache oder je Sprache.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "de": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "account": {
      "type": "string",
      "description": "Konto oder Gruppe, z. B. FIRMA\\max.mustermann oder nur der Name ohne Domäne."
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Zählt bei jedem signierten Speichern hoch. Ember nimmt nie eine ältere Fassung als die zuletzt gesehene."
    },
    "name": {
      "type": "string",
      "description": "Name des Teams, erscheint in der Seitenleiste."
    },
    "tagline": {
      "$ref": "#/$defs/text",
      "description": "Zeile unter „Ember“ in der Seitenleiste. Leer: DevProblemFixer."
    },
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "description": "Wo der Tab Berechtigungen im Active Directory sucht.",
      "properties": {
        "searchBase": {
          "type": "string",
          "description": "OU, in der (samt Unter-OUs) nach Benutzern gesucht wird, z. B. OU=Mitarbeiter,DC=firma,DC=local. Leer: die ganze Domäne."
        },
        "groupSearchBase": {
          "type": "string",
          "description": "OU für Gruppen. Leer: wie searchBase."
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Den Firmenproxy selbst (PAC-Adresse, Proxy) erkennt Ember bei jedem Start aus Windows.",
      "properties": {
        "internalDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Domains, die nicht über den Proxy laufen."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Port von px (Standard 3128)."
        }
      }
    },
    "serviceCenter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "name": {
          "type": "string"
        },
        "subjectPrefix": {
          "type": "string",
          "description": "Wird jedem Betreff vorangestellt, z. B. [Ember]."
        },
        "problemIntro": {
          "$ref": "#/$defs/text",
          "description": "Erster Satz der Mail „Problem melden“. Leer: Embers eigener Text."
        }
      }
    },
    "supervisor": {
      "type": "object",
      "description": "Direkte Vorgesetzte bzw. direkter Vorgesetzter. Anfragen nach Adminrechten gehen hierhin, nicht ans Service-Center.",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Vor- und Nachname, auch „Nachname, Vorname“."
        },
        "firstName": {
          "type": "string",
          "description": "Für „Hallo …“. Standard: das erste Wort von name."
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      }
    },
    "mailTemplates": {
      "type": "object",
      "description": "Eigene Vorlagen. Platzhalter: {user}, {computer}, {app}, {details}, {date}, {ember}, {sender} (Vor- und Nachname), {supervisor} (Vorname der bzw. des Vorgesetzten), {problemIntro}. Fehlt {sender}, hängt Ember den Gruß mit Namen an.",
      "propertyNames": {
        "enum": [
          "softwareRequest",
          "adminAction",
          "problem"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject": {
            "$ref": "#/$defs/text"
          },
          "body": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "software": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sccmName": {
            "type": "string",
            "description": "Name im Softwarecenter (Platzhalter * und ?), Standard: name."
          },
          "displayName": {
            "type": "string",
            "description": "Name unter „Programme und Features“ (Platzhalter), Standard: name + *."
          },
          "category": {
            "type": "string"
          },
          "note": {
            "$ref": "#/$defs/text"
          },
          "softwareCenterLink": {
            "type": "string",
            "pattern": "^softwarecenter:",
            "description": "Direktlink, z. B. über „Teilen“ im Softwarecenter kopiert."
          }
        }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedSchemes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Schemas, die Ember ändern darf. Standard: SCHEME_BALANCED."
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "settings"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Gleiche id wie ein eingebautes Profil (ai-performance, sleep-ac, lid-ac) ersetzt dieses."
              },
              "name": {
                "$ref": "#/$defs/text"
              },
              "description": {
                "$ref": "#/$defs/text"
              },
              "settings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sub",
                    "setting"
                  ],
                  "properties": {
                    "sub": {
                      "type": "string",
                      "description": "Untergruppe als Alias (SUB_PROCESSOR) oder GUID."
                    },
                    "setting": {
                      "type": "string",
                      "description": "Einstellung als Alias (PERFEPP) oder GUID."
                    },
                    "ac": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Zielwert am Netzteil."
                    },
                    "dc": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Zielwert im Akkubetrieb."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "description": "Wer welche Module sieht. Ohne Rollen sieht niemand etwas, Ember zeigt dann nur den Sperrbildschirm. Gepflegt im Tab „Berechtigungen“.",
      "properties": {
        "roles": {
          "type": "array",
          "description": "Rollen. Wer in mehreren Rollen ist, sieht die Module aller dieser Rollen.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "modules"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "modules": {
                "type": "array",
                "description": "Module der Rolle; \"*\" steht für alle, auch für Module, die später dazukommen. Die Startseite gibt es, sobald es ein Modul gibt.",
                "items": {
                  "enum": [
                    "*",
                    "proxy",
                    "git",
                    "software",
                    "playwright",
                    "system",
                    "power",
                    "ai",
                    "access",
                    "settings",
                    "log"
                  ]
                }
              },
              "users": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/account"
                }
              },
              "groups": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/account"
                }
              },
              "hideTools": {
                "type": "array",
                "items": {
                  "enum": [
                    "nodejs",
                    "git",
                    "vscode",
                    "python",
                    "visualstudio",
                    "dotnet",
                    "pwsh",
                    "bruno"
                  ]
                },
                "description": "Entwicklerwerkzeuge, die die Rolle nicht angeboten bekommt, z. B. [\"bruno\"]."
              }
            }
          }
        },
        "enabled": {
          "type": "boolean",
          "deprecated": true,
          "description": "Altes Format vor den Rollen. Ember liest es noch, beim Speichern im Tab „Berechtigungen“ fällt es weg."
        },
        "users": {
          "type": "array",
          "deprecated": true,
          "items": {
            "$ref": "#/$defs/account"
          },
          "description": "Altes Format: wird zur Rolle „Ember“ mit den Alltagsmodulen."
        },
        "groups": {
          "type": "array",
          "deprecated": true,
          "items": {
            "$ref": "#/$defs/account"
          },
          "description": "Altes Format: wird zur Rolle „Ember“ mit den Alltagsmodulen."
        },
        "blocked": {
          "type": "object",
          "additionalProperties": false,
          "description": "Sperrliste: wer hier steht, kommt nicht in Ember, egal was eine Rolle sagt.",
          "properties": {
            "users": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/account"
              }
            },
            "groups": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/account"
              }
            }
          }
        }
      }
    },
    "admins": {
      "type": "object",
      "additionalProperties": false,
      "deprecated": true,
      "description": "Altes Format vor den Rollen: Ember macht daraus eine Rolle „Admins“ mit allen Modulen. Beim Speichern im Tab „Berechtigungen“ fällt der Abschnitt weg.",
      "properties": {
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/account"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/account"
          }
        }
      }
    },
    "devTools": {
      "type": "object",
      "additionalProperties": false,
      "description": "Entwicklerwerkzeuge im Software-Tab.",
      "properties": {
        "tools": {
          "type": "array",
          "description": "Welche Werkzeuge erscheinen. Standard: alle.",
          "items": {
            "enum": [
              "nodejs",
              "git",
              "vscode",
              "python",
              "visualstudio",
              "dotnet",
              "pwsh",
              "bruno"
            ]
          }
        },
        "allowDirect": {
          "type": "boolean",
          "description": "false: nie direkt vom Hersteller installieren, nur über das Softwarecenter oder das Service-Center. Standard: true."
        },
        "visualStudio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bootstrapperUrl": {
              "type": "string",
              "format": "uri",
              "description": "Standard: https://aka.ms/vs/17/release/vs_professional.exe"
            },
            "workloads": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Workload-IDs für --add. Standard: ManagedDesktop und NetWeb."
            }
          }
        }
      }
    },
    "playwright": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "downloadHost": {
          "type": "string",
          "format": "uri",
          "description": "Interner Spiegel für die Browser-Downloads (setzt PLAYWRIGHT_DOWNLOAD_HOST), falls cdn.playwright.dev gesperrt ist."
        },
        "template": {
          "type": "string",
          "description": "Ordner mit der Projektvorlage des Teams (UNC-Pfad). „Neues Projekt“ kopiert ihn und ersetzt $projectname$ und $year$; im Tab „Vorlage“ lässt er sich aus einem Projekt neu erzeugen."
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mirror": {
          "type": "string",
          "description": "Optionaler UNC-Ordner mit latest.json und den Release-Dateien, falls GitHub gesperrt ist."
        }
      }
    },
    "webView2InstallerUrl": {
      "type": "string",
      "format": "uri",
      "description": "Eigene Download-Adresse für den WebView2-Installer."
    },
    "location": {
      "type": "string",
      "description": "Setzt Ember beim Signieren: der Pfad, an dem die Teamdatei gilt. Eine Kopie an anderer Stelle lehnt Ember ab."
    },
    "signedBy": {
      "type": "string",
      "description": "Setzt Ember beim Signieren."
    },
    "signedAt": {
      "type": "string",
      "description": "Setzt Ember beim Signieren."
    }
  }
}
